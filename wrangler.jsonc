{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "muntang-com",
  "main": "worker.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "upload_source_maps": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
