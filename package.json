{
  "name": "muntang-com",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "문탕닷컴 Cloudflare Worker website",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --host localhost",
    "pretest": "npm run build",
    "check": "node scripts/check.js",
    "test": "node --test",
    "build": "node scripts/build.js",
    "smoke": "node scripts/smoke.js",
    "deploy": "npm run check && npm test && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.152.0",
    "esbuild": "0.28.2",
    "linkedom": "0.18.14"
  }
}
